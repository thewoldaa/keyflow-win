# ---------------------------------------------------------------------------
# Line endings.
#
# The default on Windows is to convert LF to CRLF on checkout, which breaks
# two things here:
#
#   * The .glsl files are read by scripts/embed-shaders.ps1 and compiled into
#     ShaderTable.cpp. A CRLF in a shader source is a carriage return inside a
#     string literal, which some drivers reject.
#
#   * The .sh harness scripts are run by Git Bash, where a CRLF makes the
#     shebang line unrunnable.
#
# So both are pinned to LF, and the C++ and CMake sources are left to the
# platform: a CRLF there changes nothing.
# ---------------------------------------------------------------------------

* text=auto

# The shaders are data the compiler embeds verbatim. A line-ending conversion
# would change the bytes that reach the driver.
*.glsl text eol=lf

# Shell scripts must be runnable on the machine that checks them out.
*.sh text eol=lf

# PowerShell handles either, but keeping it consistent avoids a diff that is
# only line endings.
*.ps1 text eol=lf

# Binary assets must never be converted.
*.png binary
*.ico binary
*.jpg binary
*.webp binary
*.apk binary
